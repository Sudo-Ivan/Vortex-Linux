{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@tools/installer-sandbox",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec node ./build.mjs",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/installer-sandbox.c",
        "{projectRoot}/landlock_sandbox.c",
        "{projectRoot}/landlock_sandbox.h",
        "{projectRoot}/landlock_uapi.h",
        "{projectRoot}/seccomp_sandbox.c",
        "{projectRoot}/seccomp_sandbox.h",
        "{projectRoot}/build.mjs",
        { "runtime": "node -p process.platform" },
        { "runtime": "cc --version" }
      ],
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
